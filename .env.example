# Cloudflare Teams registration token：只填写注册链接中 token= 后面的原始三段 JWT。
# 不要包含 token=、com.cloudflare.warp:// 完整链接、引号或前后空白。
# 首次启动必须提供（若 WARP_SOCKS_ENABLE_MASQUE=1 且 MASQUE 注册与建隧道都成功，
# 全程不需要 Teams 账户，可留空）；已经在 ./data 下留有 account.json 后，
# 重启也可以留空。
TEAMS_TOKEN=header.payload.signature

# auto 自动监听 IPv4/IPv6；只允许 loopback、RFC1918 IPv4、ULA/link-local
# IPv6 客户端。UDP relay 自动跟随控制连接实际使用的本机地址和地址族。
SOCKS_LISTEN_ADDRS=auto
SOCKS_LISTEN_PORT=1080

# 留空保持默认 WARP；如 US、JP、SG，经该地区的 Psiphon SSH 建立 MASQUE H2。
# 仍使用 SOCKS_LISTEN_PORT 的唯一入口；目标网站看到 Cloudflare 出口 IP。
# 最终 IP 地区可能不同于所选 Psiphon 地区。
PSIPHON_COUNTRY=

# 高级部署可以改成显式地址列表；显式模式不附加 LAN 客户端限制，应自行
# 使用防火墙。下面是 RFC 文档地址，不能直接用于生产：
# SOCKS_LISTEN_ADDRS=127.0.0.1:1080,192.0.2.10:1080,[2001:db8::10]:1080

# 可选：手工覆盖 endpoint 候选池。
# 留空时使用项目内置候选池。
ENDPOINT_CANDIDATES=

# 是否优先尝试 MASQUE 隧道（缺 reg.json 会自动注册，失败回退 WireGuard）。
# 默认开启；0 表示首层只用 WireGuard。设置 PSIPHON_COUNTRY 后最终一层固定为 MASQUE H2。
WARP_SOCKS_ENABLE_MASQUE=1

# 其他参数保持默认即可。
# 日志、重试、启动探测、healthcheck 调优参数见 README。
