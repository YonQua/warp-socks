# Cloudflare Teams registration token。
# 推荐直接填完整的 com.cloudflare.warp://...auth?token=... 链接。
# 首次启动必须提供（若 WARP_SOCKS_ENABLE_MASQUE=1 且 MASQUE 注册与建隧道都成功，
# 全程不需要 Teams 账户，可留空）；已经在 ./data 下留有 account.json 后，
# 重启也可以留空。
TEAMS_TOKEN=com.cloudflare.warp://your-team.cloudflareaccess.com/auth?token=replace-with-fresh-registration-token

# host network 下程序直接绑定宿主机地址，第一个地址用于内部健康探测。
# 安全默认值只允许本机访问。
# 需要远端客户端时，按实际网络填写宿主机可达的 IPv4/IPv6 地址；下面的
# 192.0.2.0/24 和 2001:db8::/32 只是 RFC 文档地址，不能直接用于生产：
# SOCKS_LISTEN_ADDRS=127.0.0.1:1080,192.0.2.10:1080,[2001:db8::10]:1080
SOCKS_LISTEN_ADDRS=127.0.0.1:1080

# 可选：手工覆盖 endpoint 候选池。
# 留空时使用项目内置候选池。
ENDPOINT_CANDIDATES=

# 是否优先尝试 MASQUE 隧道（缺 reg.json 会自动注册，失败回退 WireGuard）。
# 默认开启；显式设为 0 可强制只走 WireGuard。
WARP_SOCKS_ENABLE_MASQUE=1

# 其他参数保持默认即可。
# 日志、重试、启动探测、healthcheck 调优参数见 README。
